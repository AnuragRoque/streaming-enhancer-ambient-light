{
  "manifest_version": 3,
  "name": "QualityLock",
  "version": "1.2.1",
  "description": "Keeps streams at top quality, plus a floating video toolbar: fill/zoom/aspect, ambient light, picture filters, speed, PiP and mouse controls.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "QualityLock",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-video-hud": {
      "suggested_key": { "default": "Alt+Z" },
      "description": "Show / hide the floating video toolbar"
    },
    "quick-ratio": {
      "suggested_key": { "default": "Alt+X" },
      "description": "Cycle Fill, Stretch, 16:9, 21:9 and zoom presets"
    },
    "speed-up": {
      "suggested_key": { "default": "Alt+Period" },
      "description": "Speed up"
    },
    "speed-down": {
      "suggested_key": { "default": "Alt+Comma" },
      "description": "Slow down"
    },
    "speed-reset": { "description": "Normal speed (1×)" },
    "seek-back": { "description": "Seek back (step set in the popup)" },
    "seek-forward": { "description": "Seek forward (step set in the popup)" },
    "toggle-fill": { "description": "Hide black bars on / off" },
    "cycle-backdrop": { "description": "Cycle ambient light / blur fill / off" },
    "toggle-pip": { "description": "Picture-in-Picture" },
    "toggle-fullscreen": { "description": "Fullscreen (player)" },
    "window-fullscreen": { "description": "Fill the browser window" },
    "toggle-lights": { "description": "Lights off (dim the page)" },
    "snapshot": { "description": "Save the current frame as PNG" },
    "zoom-in": { "description": "Zoom video in 5%" },
    "zoom-out": { "description": "Zoom video out 5%" },
    "reset-video": { "description": "Reset zoom, ratio and rotation" }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "inject.js",
        "player.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "defaults.js",
        "bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
